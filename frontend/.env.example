# Copy this file to .env.local (gitignored, see .gitignore's `*.local` rule)
# and adjust if your backend runs somewhere other than the default.
#
# Vite only exposes env vars prefixed VITE_ to client-side code -- see
# src/services/api.ts for where this gets read via import.meta.env.
VITE_API_BASE_URL=http://127.0.0.1:8000
