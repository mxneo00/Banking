# Copy this file to .env and adjust if needed. .env should be in .gitignore —
# never commit real credentials, even "fake" local ones out of habit.

# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# - HOST is "db" when the API itself also runs inside docker-compose (it uses
#   the service name as the hostname, not localhost).
# - HOST is "localhost" when you run uvicorn directly on your machine and only
#   Postgres is in Docker (that's the setup these defaults assume).
DATABASE_URL=postgresql+psycopg://banking_user:banking_pass@localhost:5432/banking

# --- Auth / JWT ---------------------------------------------------------
# JWT_SECRET_KEY signs every access/refresh token -- anyone who has it can
# forge tokens for ANY user/role. Generate a real random value per
# deployment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER reuse the placeholder below outside local dev.
JWT_SECRET_KEY=dev-only-change-me-1f8a6c2e9b7d4f0a3c5e8b1d6f2a9c4e
JWT_ALGORITHM=HS256
# Short-lived: limits the damage window if an access token leaks.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Long-lived: how long a user stays logged in before re-entering a password.
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ----------------------------------------------------------------
# Comma-separated list of origins allowed to call this API from a browser.
# 5173 is Vite's default dev server port. Add a real deployed frontend URL
# here (comma-separated) once one exists -- never use "*" alongside
# allow_credentials=True, browsers reject that combination outright.
#
# Production (CloudFront): CORS_ORIGINS=https://dxxxx.cloudfront.net
CORS_ORIGINS=http://localhost:5173

# --- Demo seed data ------------------------------------------------------
# On API startup, init_db() always creates missing tables. seed_all_demo_data()
# runs only when this is true (the local default). Set false on EC2 unless you
# want the well-known demo logins (admin@bank.local / admin123, etc.) public.
SEED_DEMO_DATA=true

# Production DATABASE_URL (Supabase session pooler, IPv4 + SSL), e.g.:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Local demo data (seeded on API startup when SEED_DEMO_DATA is true) --
# seed_all_demo_data() in app/models/database.py inserts missing rows only.
#
# Staff (login at /login — role picks dashboard):
#   admin@bank.local        / admin123     (admin, all branches)
#   teller@bank.local       / teller123    (teller, BR001)
#   manager@bank.local      / manager123   (branch_manager, BR001)
#   teller.east@bank.local  / teller123    (teller, BR002)
#
# Customers (customer portal):
#   aisha@example.com / customer123   CUST-01 BR001  (checking ACC-123 + savings ACC-124, budgets)
#   ben@example.com   / customer123   CUST-02 BR001  (checking ACC-456)
#   cara@example.com  / customer123   CUST-03 BR001  (no accounts — empty state)
#   elena@example.com / customer123   CUST-05 BR002  (checking ACC-789)
# Inactive profile (no login): CUST-04 Dan Lee on BR001
#
# Also seeds ~12 recent ledger rows for Branch overview / history demos.
