# Copy this file to .env and adjust if needed. .env should be in .gitignore —
# never commit real credentials, even "fake" local ones out of habit.

# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# - HOST is "db" when the API itself also runs inside docker-compose (it uses
#   the service name as the hostname, not localhost).
# - HOST is "localhost" when you run uvicorn directly on your machine and only
#   Postgres is in Docker (that's the setup these defaults assume).
DATABASE_URL=postgresql+psycopg://banking_user:banking_pass@localhost:5432/banking
