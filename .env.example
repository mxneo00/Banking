# Copy this file to .env and adjust if needed. .env should be in .gitignore —
# never commit real credentials, even "fake" local ones out of habit.

# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# - HOST is "db" when the API itself also runs inside docker-compose (it uses
#   the service name as the hostname, not localhost).
# - HOST is "localhost" when you run uvicorn directly on your machine and only
#   Postgres is in Docker (that's the setup these defaults assume).
DATABASE_URL=postgresql+psycopg://banking_user:banking_pass@localhost:5432/banking

# --- Auth / JWT ---------------------------------------------------------
# JWT_SECRET_KEY signs every access/refresh token -- anyone who has it can
# forge tokens for ANY user/role. Generate a real random value per
# deployment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER reuse the placeholder below outside local dev.
JWT_SECRET_KEY=dev-only-change-me-1f8a6c2e9b7d4f0a3c5e8b1d6f2a9c4e
JWT_ALGORITHM=HS256
# Short-lived: limits the damage window if an access token leaks.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Long-lived: how long a user stays logged in before re-entering a password.
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ----------------------------------------------------------------
# Comma-separated list of origins allowed to call this API from a browser.
# 5173 is Vite's default dev server port. Add a real deployed frontend URL
# here (comma-separated) once one exists -- never use "*" alongside
# allow_credentials=True, browsers reject that combination outright.
CORS_ORIGINS=http://localhost:5173

# --- Local demo staff (seeded on API startup; not env-driven) ------------
# Staff cannot self-register. On startup:
#   seed_demo_admin()  -> admin@bank.local / admin123  (only if users table empty)
#   seed_demo_staff()  -> additional teller + manager if those emails are missing:
#     teller@bank.local  / teller123   (teller, branch BR001)
#     manager@bank.local / manager123  (branch_manager, branch BR001)
# Use the frontend /staff/login page with these credentials.
